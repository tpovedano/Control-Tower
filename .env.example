# ---------- Procore (app ya registrada en el Developer Portal) ----------
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
# Producción
PROCORE_BASE_URL=https://api.procore.com
PROCORE_LOGIN_URL=https://login.procore.com
# Sandbox (se usa cuando una instancia está marcada como "sandbox")
PROCORE_SANDBOX_BASE_URL=https://sandbox.procore.com
PROCORE_SANDBOX_LOGIN_URL=https://login-sandbox.procore.com

# ---------- Base de datos (Vercel Postgres / Neon) ----------
POSTGRES_URL=postgres://user:password@host/db?sslmode=require

# ---------- Seguridad ----------
# 32 bytes en base64 o 64 caracteres hex. Generar con: openssl rand -base64 32
ENCRYPTION_KEY=
# Secreto para firmar la cookie de sesión (si se omite se deriva de ENCRYPTION_KEY)
SESSION_SECRET=
# Contraseña de acceso a la app (obligatoria). Sin ella nadie puede entrar.
APP_ACCESS_PASSWORD=
# Opcional: lista blanca de usuarios (correos separados por coma). Si se define,
# en el login hay que indicar un correo de esta lista; queda registrado en el audit log.
APP_ALLOWED_USERS=

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Límite de filas por lote en la pestaña Cargar
MAX_ROWS_PER_BATCH=500
# Peticiones simultáneas máximas por instancia de Procore
PROCORE_MAX_CONCURRENCY=3
# Driver de BD: se detecta solo (Neon → HTTP serverless; otro Postgres → postgres-js). Forzar con neon | postgres
DB_DRIVER=
# Orígenes que pueden incrustar la app (app "full screen" en Procore). Separados por espacios.
PROCORE_EMBED_ORIGINS=https://*.procore.com https://procore.com
